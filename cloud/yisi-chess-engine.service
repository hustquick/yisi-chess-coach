[Unit]
Description=Yisi Chess native Stockfish analysis
After=network.target
[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/projects/yisi-chess
Environment=STOCKFISH_PATH=/home/ubuntu/projects/yisi-chess/Stockfish/src/stockfish
ExecStart=/home/ubuntu/projects/yisi-xiangqi-p2p/runtime/node-v22.22.0-linux-arm64/bin/node server.mjs
Restart=on-failure
MemoryMax=1200M
CPUQuota=100%
NoNewPrivileges=true
PrivateTmp=true
[Install]
WantedBy=multi-user.target
