.DS_Store

# HTML dependencies and generated output
/html/node_modules/
/html/.local/
/html/.vinext/
/html/.vite/
/html/.wrangler/
/html/dist/
/html/coverage/
/html/tsconfig.tsbuildinfo

# Android machine-local and generated output
/android/.gradle/
/android/local.properties
/android/**/.cxx/
/android/**/build/

# Xcode generated output and user state
/iOS/build/
/iOS/DerivedData/
/iOS/**/*.xcuserdatad/
/iOS/**/*.xcuserstate

# Official NNUE networks are larger than GitHub's regular file limit. Restore
# them after cloning with tools/setup-engine.sh.
/shared/Stockfish/src/*.nnue
/iOS/ThirdParty/Stockfish/src/*.nnue
/iOS/App/Resources/stockfish.nnue

# Environment and debug files
.env*
*.log
